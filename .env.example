# Copia questi nomi in Vercel > Project > Settings > Environment Variables.
# NON scrivere mai i valori veri in questo file o in chat.

# Obbligatori
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Facoltativi (questi sono i valori predefiniti)
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
CHAT_DAILY_LIMIT=100
IMAGE_DAILY_LIMIT=8
VOICE_DAILY_LIMIT=60
