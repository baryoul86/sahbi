# Copia questi nomi in Vercel > Project > Settings > Environment Variables.
# NON scrivere mai i valori veri in questo file o in chat.

# ---------- Obbligatori ----------
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Pagamenti (facoltativi: senza, i pulsanti dicono "Bientôt disponible") ----------
# Indirizzo pubblico dell'app (per i ritorni dopo il pagamento), es. https://sahbi.app
PUBLIC_URL=
# Stripe (carte): chiave segreta, ID del prezzo mensile, segreto del webhook /api/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRO_PRICE_EUR_LABEL=6,50 €
# Abbonamento annuale (facoltativo): secondo prezzo Stripe "annuale" (es. 59 €/anno). Senza, si vede solo il mensile.
STRIPE_PRICE_ID_YEAR=
PRO_PRICE_YEAR_LABEL=59 €
CHARGILY_PRICE_YEAR_DZD=10000
# Lemon Squeezy (carta + PayPal, IVA di tutti i paesi gestita da loro). Se c'è, il pulsante "Carte" usa Lemon Squeezy.
# Webhook da creare su Lemon Squeezy: https://www.sahbi.bond/api/lemonsqueezy-webhook
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_VARIANT_ID_YEAR=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Chargily Pay (Edahabia / CIB): chiave segreta; per le prove CHARGILY_API_URL=https://pay.chargily.net/test/api/v2
CHARGILY_SECRET_KEY=
CHARGILY_API_URL=https://pay.chargily.net/api/v2
CHARGILY_PRICE_DZD=1000
CHARGILY_PRO_DAYS=30

# ---------- Pubblicità per chi non è Pro: Google AdSense (vuoto = solo promozioni di Sahbi) ----------
ADSENSE_CLIENT=ca-pub-4750815574904840
ADSENSE_SLOT=1479809952

# ---------- Video di 8 secondi (solo Pro) con Pruna P-Video: senza chiave i video sono spenti ----------
PRUNA_API_KEY=
PRUNA_VIDEO_MODEL=p-video-2
VIDEO_SECONDS=8
VIDEO_RESOLUTION=720p
VIDEO_ASPECT=9:16
PRO_VIDEO_MONTHLY_LIMIT=5
FREE_VIDEO_MONTHLY_LIMIT=0

# ---------- Amministratore: avvisi e resoconto quotidiano per e-mail (Resend) ----------
ADMIN_EMAIL=
RESEND_API_KEY=
# App Android: impronte SHA-256 separate da virgola (chiave di caricamento + chiave Google Play)
ANDROID_SHA256=

# ---------- Memoria di Sahbi (serve supabase/004_memory.sql). "false" per spegnerla ----------
MEMORY_ENABLED=true

# ---------- Limiti giornalieri (questi sono i valori predefiniti) ----------
FREE_CHAT_DAILY_LIMIT=30
FREE_IMAGE_DAILY_LIMIT=2
FREE_VOICE_DAILY_LIMIT=20
FREE_TTS_DAILY_LIMIT=0
PRO_CHAT_DAILY_LIMIT=300
PRO_IMAGE_DAILY_LIMIT=8
PRO_VOICE_DAILY_LIMIT=100
PRO_TTS_DAILY_LIMIT=100

# ---------- Modelli OpenAI (valori predefiniti) ----------
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
