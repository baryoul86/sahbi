{
  "functions": {
    "api/chat.js": {
      "maxDuration": 300
    },
    "api/library.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 30
    },
    "api/speak.js": {
      "maxDuration": 30
    },
    "api/stripe-webhook.js": {
      "maxDuration": 30
    },
    "api/chargily-webhook.js": {
      "maxDuration": 30
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(sw.js|i18n.js|index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sahbi.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"sahbi.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/conditions-utilisation",
      "destination": "/conditions-utilisation.html"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/config?file=ads.txt"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/config?file=assetlinks"
    },
    {
      "source": "/api/lemonsqueezy-webhook",
      "destination": "/api/stripe-webhook?provider=lemonsqueezy"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?cron=1",
      "schedule": "30 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/conditions.html",
      "destination": "/conditions-utilisation",
      "permanent": true
    }
  ]
}
