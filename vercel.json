{
  "functions": {
    "api/chat.js": {
      "maxDuration": 300
    },
    "api/library.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 30
    },
    "api/speak.js": {
      "maxDuration": 30
    },
    "api/stripe-webhook.js": {
      "maxDuration": 30
    },
    "api/chargily-webhook.js": {
      "maxDuration": 30
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/api/config?file=ads.txt"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/config?file=assetlinks"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?cron=1",
      "schedule": "30 6 * * *"
    }
  ]
}
